<%- include("./includes/head")%>
    <h1>I am Post Page</h1>
    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Magnam illo sunt dicta hic ipsum labore voluptates commodi aliquam obcaecati veritatis, placeat et reiciendis unde nam cum, ea accusamus, minima cupiditate.</p>
 
    <br/><hr/><br/>
    <div class="login-out-bar">
        <% if(isLogin) { %>
            <% if(posts.length < 1) { %>
                Nothing to see now. <a href="/admin/create-post">+Add New Post</a>
            <% }else{ %>
                <a href="/admin/create-post">+Add New Post</a>
            <% } %>
            &nbsp;
            <form action="/logout" method="post">
                <button>Logout</button>
            </form>
        <% }else{ %>
            <div class="post_action">
                <a href="/login">Login to existing account</a>
                <a href="/register">Create a new account</a>
            </div>
        <% } %>
    </div>
    <br/>
    <% for(let post of posts) {%>
        <div class="posts-box">
            <p class="post-title"><%= post.title%></p>
            <a href="/posts/<%= post._id%>">See More ...</a>
        </div>
    <% } %>
    <%- include("./includes/foot")%>
    <br/>
    