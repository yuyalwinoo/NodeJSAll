<%- include("../includes/head")%>
    <h1 class="title">Login Here!</h1>
    <div class="go-to-posts">
        <a href="/posts">View All Posts</a>
    </div>
    <section class="form-section">
        <% if(errorMsg.length){%>
            <p class="error"><%= errorMsg %></p>
        <% } %>
        <form action="/login" method="post">
            <input type="hidden" value="<%= csrfToken%>" name="_csrf"/>
            <div>
                <label for="email">Enter Email</label>
                <input type="text" id="email" name="email" value="<%= oldFrameData.email%>"/>
            </div>

            <div>
                <label for="password">Enter Password</label>
                <input type="password" id="password" name="password" value="<%= oldFrameData.password%>"/>
            </div>
            <div>
                <a href="/reset-password" class="no-style-a">Forget Password?</a>
            </div>
            <div>
                <button>Login</button>
            </div>
        </form>
    </section>
    <%- include("../includes/foot")%>
