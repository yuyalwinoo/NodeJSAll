<%- include("../includes/head")%>
    <h1 class="title">Change New Password</h1>
    <div class="go-to-posts">
        <a href="/posts">View All Posts</a>
    </div>
    <section class="form-section">
        <% if(errorMsg.length){%>
            <p class="error"><%= errorMsg %></p>
        <% } %>
        <form action="/change-new-password" method="post">
            <input type="hidden" value="<%= csrfToken%>" name="_csrf"/>
            <input type="hidden" name="resultToken" value="<%= resultToken %>"/>
            <input type="hidden" name="userId" value="<%= userId %>"/>

            <div>
                <label for="password">Enter New Password</label>
                <input type="password" id="password" name="password"/>
            </div>
            <div>
                <label for="confirmPassword">Enter New Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword"/>
            </div>
            <div>
                <button>Reset</button>
            </div>
        </form>
    </section>
    <%- include("../includes/foot")%>
