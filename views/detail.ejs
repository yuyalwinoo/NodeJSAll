<%- include("./includes/head")%>
    <section class="form-section" style="width: 60% !important;">
        <div class="post-head-section">
            <h1 class=""><%= post.title %></h1>
            <% if(post.userId.toString() === currentUserId.toString()){%>
                <div class="post_action">
                    <a href="/admin/edit/<%= post._id %>">Edit</a>&nbsp;
                    <form action="/admin/delete/<%= post._id %>" method="post">
                        <input type="hidden" value="<%= csrfToken%>" name="_csrf"/>
                        <button>Delete</button>
                    </form>
                </div>
            <%}%>
        </div>
        
        <img class="detail-img" src=<%= post.imgUrl %> alt=<%= post.title %>/>
        <p class="post-desc"><%= post.description %></p>
        <br/>
        <div class="view_all_post_button_container">
            <a href="/posts">View All Posts</a>
        </div>
    </section>
    <%- include("./includes/foot")%>
